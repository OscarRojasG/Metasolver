std::vector<std::vector<double>> MCTS_RolloutStrategy::get_rollout_history() const {
    return rollout_history;
}

std::vector<std::vector<double>> MCTS_RolloutStrategy::get_rollout_std_history() const {
    return rollout_std_history;
}


int select_index_power_law(int n, double alpha) {
    std::vector<double> cdf(n);
    double sum = 0.0;
    
    for (int i = 0; i < n; ++i) {
        sum += std::pow(i + 1, -alpha);
    }
    
    double current = 0.0;
    for (int i = 0; i < n; ++i) {
        current += (std::pow(i + 1, -alpha) / sum);
        cdf[i] = current;
    }
    
    double r = (double)rand() / RAND_MAX;
    auto it = std::lower_bound(cdf.begin(), cdf.end(), r);
    return std::distance(cdf.begin(), it);
}

list<State*> MCTS_RolloutStrategy::next(list<State*>& S) {
    list<State*> next_generation;

    if (S.empty() || get_time() > timelimit) return next_generation;

    State* current_state = S.front();

    list<Action*> rcl_actions;
    get_best_actions(*current_state, rcl_actions, w);

    if (rcl_actions.empty()) return next_generation;

    std::vector<Action*> actions_vector(rcl_actions.begin(), rcl_actions.end());
    std::vector<double> current_step_volumes;
    std::vector<double> current_step_std;

    Action* best_action_overall = nullptr;

    int prob = 30;
    if (current_state->get_value() == 0) {
        prob = 0;
    }

    for (Action* act : actions_vector) {
        if (get_time() > timelimit) break;

        State* child_state = current_state->clone();
        child_state->transition(*act);

        // Inicialización para Algoritmo de Welford
        double mean = 0.0;
        double M2 = 0.0;
        int successful_rollouts = 0;

        for (int n = 0; n < num_rollouts; ++n) {
            if (get_time() > timelimit) break;
            State* rollout_state = child_state->clone();

            // Cálculo de alpha dinámico (mantenido según tu lógica actual)
            double current_v = current_state->get_value();
            double max_v = 1.0;
            double alpha_min = 0;
            double alpha_max = 1.5;
            double dynamic_alpha = alpha_min + (alpha_max - alpha_min) * (current_v / max_v);
            dynamic_alpha = min(dynamic_alpha, 1.2);

            while (true) {
                list<Action*> local_actions;
                get_best_actions(*rollout_state, local_actions, w * w);
                if (local_actions.empty()) break;
            
                std::vector<Action*> sim_vector(local_actions.begin(), local_actions.end());
                
                Action* chosen_sim_action = nullptr;
                // --- LÓGICA DE SELECCIÓN (Tu lógica original) ---
                if ((rand() % 100) < prob) {
                    chosen_sim_action = local_actions.front();
                } else {
                    chosen_sim_action = sim_vector[rand() % sim_vector.size()];
                }
                
                for (Action* a : sim_vector) {
                    if (a != chosen_sim_action) delete a;
                }
                
                rollout_state->transition(*chosen_sim_action);
                delete chosen_sim_action;
            }

            // --- Actualización de Welford ---
            double val = rollout_state->get_value();
            successful_rollouts++;
            
            double delta = val - mean;
            mean += delta / successful_rollouts;
            double delta2 = val - mean;
            M2 += delta * delta2;

            delete rollout_state;
        }

        if (successful_rollouts > 0) {
            // Varianza muestral (N-1)
            double variance = (successful_rollouts > 1) ? (M2 / (successful_rollouts - 1)) : 0.0;
            double std_dev = std::sqrt(std::max(0.0, variance)); 
            
            current_step_volumes.push_back(mean);      // La media es el average_volume
            current_step_std.push_back(std_dev);       // std_dev corregida
        }
        delete child_state;
    }

    // --- SELECCIÓN EPSILON-GREEDY ---
    if (!current_step_volumes.empty()) {
        rollout_history.push_back(current_step_volumes);
        rollout_std_history.push_back(current_step_std);
    
        // 1. Identificar la mejor acción (explotación)
        auto max_it = std::max_element(current_step_volumes.begin(), current_step_volumes.end());
        int best_idx = std::distance(current_step_volumes.begin(), max_it);
    
        // 2. Definir Epsilon (puedes pasarlo como parámetro o calcularlo dinámicamente)
        // Ejemplo: 0.3 significa 30% exploración, 70% explotación
        double epsilon = 0; 
        
        double r = (double)rand() / RAND_MAX;
    
        if (r < epsilon) {
            // EXPLORACIÓN: Elegir acción aleatoria entre todas las posibles
            // Esto obliga al modelo a visitar estados "no óptimos"
            int selected_idx = rand() % actions_vector.size();
            best_action_overall = actions_vector[selected_idx];
        } else {
            // EXPLOTACIÓN: Elegir la mejor acción encontrada
            best_action_overall = actions_vector[best_idx];
        }
    }

    if (best_action_overall != nullptr) {
        State* next_state = current_state->clone();
        next_state->transition(*best_action_overall);
        next_generation.push_back(next_state);

        if (next_state->get_value() > get_best_value()) {
            if (best_state) delete best_state;
            best_state = next_state->clone();
        }
    }

    for (Action* act : actions_vector) delete act;
    return next_generation;
}

